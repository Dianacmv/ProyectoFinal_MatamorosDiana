@model IEnumerable<ProyectoFinal_MatamorosDiana.Models.Carrera>

@{
    ViewData["Title"] = "Carreras";
    bool esAdministrador = User.IsInRole("Administrador");
}

<div class="container mt-4">
    <h2 class="mb-3">Carreras universitarias</h2>

    <p>Consulte las carreras disponibles en la universidad.</p>

    @if (esAdministrador)
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">
                Agregar carrera
            </a>
        </p>
    }

    <table class="table table-striped table-bordered">
        <thead class="table-primary">
            <tr>
                <th>Nombre de la carrera</th>
                <th>Descripción</th>

                @if (esAdministrador)
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>

                    @if (esAdministrador)
                    {
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
