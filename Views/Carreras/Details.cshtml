@model ProyectoFinal_MatamorosDiana.Models.Carrera

@{
    ViewData["Title"] = "Detalles de la carrera";
}

<div class="container mt-4">
    <h2>Detalles de la carrera</h2>
    <p>Información de la carrera seleccionada.</p>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">
                            Nombre de la carrera
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Nombre
                        </dd>

                        <dt class="col-sm-4">
                            Descripción
                        </dt>
                        <dd class="col-sm-8">
                            @Model.Descripcion
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Editar carrera
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver al listado
                </a>
            </div>
        </div>
    </div>
</div>
