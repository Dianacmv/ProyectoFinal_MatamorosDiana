@model ProyectoFinal_MatamorosDiana.Models.Carrera

@{
    ViewData["Title"] = "Agregar carrera";
}

<div class="container mt-4">
    <h2>Agregar carrera</h2>
    <p>Complete la información de la carrera universitaria.</p>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion"
                              class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar carrera
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Volver al listado
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
