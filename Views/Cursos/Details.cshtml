@model ProyectoFinal_MatamorosDiana.Models.Curso

@{
    ViewData["Title"] = "Detalles del curso";
}

<div class="container mt-4">
    <h2>Detalles del curso</h2>
    <p>Información del curso seleccionado.</p>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Código</dt>
                        <dd class="col-sm-8">
                            @Model.Codigo
                        </dd>

                        <dt class="col-sm-4">Nombre del curso</dt>
                        <dd class="col-sm-8">
                            @Model.Nombre
                        </dd>

                        <dt class="col-sm-4">Créditos</dt>
                        <dd class="col-sm-8">
                            @Model.Creditos
                        </dd>

                        <dt class="col-sm-4">Horario</dt>
                        <dd class="col-sm-8">
                            @Model.Horario
                        </dd>

                        <dt class="col-sm-4">Carrera</dt>
                        <dd class="col-sm-8">
                            @Model.Carrera?.Nombre
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Editar curso
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Volver al listado
                </a>
            </div>
        </div>
    </div>
</div>
