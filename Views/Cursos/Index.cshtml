@model IEnumerable<ProyectoFinal_MatamorosDiana.Models.Curso>

@{
    ViewData["Title"] = "Cursos";
}

<div class="container mt-4">
    <h2 class="mb-3">Gestión de cursos</h2>

    <p>En este apartado puede consultar y administrar los cursos universitarios.</p>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            Agregar curso
        </a>
    </p>

    <table class="table table-striped table-bordered">
        <thead class="table-primary">
            <tr>
                <th>Código</th>
                <th>Nombre del curso</th>
                <th>Créditos</th>
                <th>Horario</th>
                <th>Carrera</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Creditos</td>
                    <td>@item.Horario</td>
                    <td>@item.Carrera?.Nombre</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">Editar</a>

                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">Detalles</a>

                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
